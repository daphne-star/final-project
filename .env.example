# Ghost Board environment.
#
# Copy to .env, either beside this file or in the folder above the repo.
# Both are read; this one wins if both exist. A real environment variable
# beats both.
#
# Never commit a real .env.

# --- Database ---------------------------------------------------------------
# Native Windows PostgreSQL install (no Docker on this machine).
DATABASE_URL=postgresql+asyncpg://postgres:ghostboard@localhost:5432/ghostboard

# --- Auth -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-anything-leaves-localhost
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- AI provider ------------------------------------------------------------
# AGENTS.md pins this project to OpenAI-compatible calls routed through Portkey.
# The key stays server-side; it is never sent to the browser.
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
DEFAULT_MODEL=gpt-6-luna

# --- Execution and cost controls --------------------------------------------
MAX_DEBATE_ROUNDS=2
MAX_MODEL_REQUESTS_PER_MEETING=60
MAX_TOOL_CALLS_PER_MEETING=40
MODEL_TIMEOUT_SECONDS=120

# Token counts are always known, so this ceiling is always enforceable.
MAX_TOTAL_TOKENS_PER_MEETING=400000

# The cost ceiling only binds when a price is configured below. Without one,
# estimated cost is reported as unknown rather than as zero.
MEETING_COST_LIMIT_USD=5.00

# USD per million tokens, per model. Rates are configuration, not a guess:
# leave this unset rather than invent a number.
# MODEL_PRICES={"gpt-6-luna": {"input_per_million": 2.50, "output_per_million": 10.00}}

# --- Documents ---------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
# UPLOAD_DIR defaults to backend/var/uploads.
# UPLOAD_DIR=

# --- Test tuning -------------------------------------------------------------
# bcrypt work factor. Leave at the default in production; the test suite drops
# it to 4, since hashing a throwaway password hundreds of times proves nothing.
# BCRYPT_ROUNDS=12

# --- App --------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
